# Copy this file to .env and fill in the values before deploying.
# docker-compose reads .env automatically.

# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret

# Optional — defaults to 2 workers; set to (2 × vCPUs + 1) for your EC2 type
WEB_CONCURRENCY=2
